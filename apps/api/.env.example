NODE_ENV=development
PORT=3000

DB_HOST=localhost
DB_PORT=5432
DB_USER=app
DB_PASSWORD=app_local_password
DB_NAME=desktop_rbac

# Generate each one with: openssl rand -base64 48
JWT_ACCESS_SECRET=replace_this_with_a_long_random_secret
JWT_REFRESH_SECRET=replace_this_with_ANOTHER_distinct_secret
JWT_ACCESS_TTL=900          # 15 minutes, in seconds
JWT_REFRESH_TTL=604800      # 7 days, in seconds

# Super admin seed
SUPER_ADMIN_USERNAME=admin
SUPER_ADMIN_PASSWORD=ChangeThisPassword_2026!
SUPER_ADMIN_NAME=Super Admin
